# CampusClaw 迭代 1 环境变量示例（复制为 .env 后按需修改）
# 必填：会话签名密钥，缺失时服务端启动失败（失败即停，不内置默认值）
SESSION_SECRET=please-change-me-to-a-long-random-string

# 服务监听
HOST=127.0.0.1
PORT=8080

# 数据与上传
DB_PATH=./data/campusclaw.db
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# 会话
SESSION_TTL_SECONDS=7200

# 登录限流（用户名 + IP 维度）
LOGIN_FAIL_THRESHOLD=5
LOGIN_LOCK_SECONDS=60

# ============ 第 4 课：可追溯知识库检索 ============

# 嵌入模型（把切片与问句转成向量）。支持任意 OpenAI 兼容服务。
#   openai = 调用远端 /embeddings（阿里云百炼 / 硅基流动 / Ollama / 课程网关…）
#   local  = 本地确定性伪向量，仅用于没有密钥时跑通链路，不具备真正的语义能力
EMBEDDING_PROVIDER=openai
# 阿里云百炼公共云（对话与嵌入同一把 key、同一个 base_url）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-你的阿里云百炼key
EMBEDDING_MODEL=text-embedding-v4
# 与 text-embedding-v4 的 dimensions 参数一致；换成别的模型时必须同步改这里
EMBEDDING_DIM=1024
# 阿里云百炼 v3/v4 单次最多 10 条
EMBEDDING_BATCH_SIZE=10

# 对话模型（有命中切片时才调用）
CHAT_PROVIDER=openai
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=sk-你的阿里云百炼key
CHAT_MODEL=qwen-plus
CHAT_TIMEOUT_MS=60000

# 检索参数（对应课件规约）
VECTOR_MIN_SCORE=0.35
RRF_K=60
RETRIEVE_TOP_K=10
ASK_TOP_K=4
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=80

# 跨班可见开关
# 0（默认，课程要求）= 跨班完全隔离：列表看不到，按 ID 访问与下载一律 404
# 1（演示模式）     = 列表能看到其他班级的材料标题，但正文与下载返回 403
CROSS_CLASS_VISIBLE=0

# Docker Compose（docker compose up 时生效）
WEB_PORT=8080
# 置于反向代理之后时设为 1，让登录限流按真实客户端 IP 计数
TRUST_PROXY=0
# Docker 构建使用的 npm 源
NPM_REGISTRY=https://registry.npmmirror.com

# 种子账号口令（仅用于本地演示）
SEED_TEACHER_PASSWORD=Teacher@123
SEED_STUDENT_PASSWORD=Student@123
